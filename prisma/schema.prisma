// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  student       Student?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Student {
  id              String   @id @default(cuid())

  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  rollNumber      String   @unique
  department      String
  graduationYear  Int

  leetcode        String?
  codeforces      String?
  gfg             String?
  codechef        String?

  profileComplete Boolean  @default(false)
  lastSyncedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stats    StudentStats?
  syncJobs SyncJob[]

  dailySnapshots      DailySnapshot[]
  monthlyAchievements MonthlyAchievement[]
}

model StudentStats {
  id String @id @default(cuid())

  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  leetcodeSolved      Int  @default(0)
  leetcodeRating      Int?

  codeforcesRating    Int?
  codeforcesMaxRating Int?
  codeforcesRank      String?
  codeforcesMaxRank   String?
  codeforcesSolved    Int  @default(0)
  codeforcesAvatar    String?
  codeforcesContribution Int?

  gfgScore            Int?

  codechefRating      Int?

  totalScore          Int  @default(0)
  ranking             Int?
  departmentRanking   Int?

  updatedAt DateTime @updatedAt

  @@index([totalScore(sort: Desc)])
}

model SyncJob {
  id         String    @id @default(cuid())
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     String    @default("PENDING")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  error      String?   @db.Text

  createdAt DateTime @default(now())
}

model DailySnapshot {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date

  leetcodeSolved   Int      @default(0)
  codeforcesSolved Int      @default(0)
  gfgScore         Int      @default(0)
  codechefRating   Int      @default(0)
  totalScore       Int      @default(0)

  createdAt        DateTime @default(now())

  @@unique([studentId, date])
  @@index([studentId, date])
  @@index([date])
}

model MonthlyAchievement {
  id            String   @id @default(cuid())
  category      String   // "Beginner of the month", "Problem solver of the month", etc.
  title         String
  month         Int      // 1 - 12
  year          Int

  studentId     String?
  student       Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  department    String?

  scoreOrMetric String   // e.g. "+820 CP Growth this month", "118 Solved"
  badgeIcon     String   // e.g. "🌟", "⚡", "🏆"
  isManual      Boolean  @default(false)

  createdAt     DateTime @default(now())

  @@index([year, month])
  @@index([category])
}

